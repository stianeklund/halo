/_qmpcap/
/delinked/
/input-recordings/
/*.bin
*.dump
*.dmp
*.raw
ram*.bin
tmp*.bin
cap_test*.bin
artifacts/**/*.bin
# Halo saved-game heap cores + fixture binaries (copyrighted game state) — never commit
**/core.bin
tools/xbox/fixtures/**/*.bin
artifacts/snapshots/
artifacts/*snapshot*.json
# Equivalence-test artifacts — must NEVER be committed (game-state snapshots, logs, dumps)
artifacts/equivalence/
artifacts/memory_dumps/
# Golden waveform tables: read straight out of the unpatched cachebeta.xbe (see
# the docstring of tools/verify/test_periodic_tables.py), so they are original
# game data, not synthetic fixtures. Regenerate locally from a real Xbox/XBDM
# read instead of committing them.
tests/golden/periodic_tables/*.bin

# Ephemeral repo-local state
/Invalid

# Local config
opencode.json

# Agent configuration: only the Claude Code doctrine is committed. Everything else
# under .claude/ (settings.local.json, agent-memory, worktrees, scheduled_tasks.lock,
# analyst_session.md, ...) is per-host state. .opencode/ and .agents/ are local-only.
/.claude/*
!/.claude/settings.json
!/.claude/skills/
!/.claude/commands/
!/.claude/agents/
!/.claude/workflows/
/.rtk/*
!/.rtk/filters.toml
/.opencode/
/.agents/
/.agent/

# Semantic-retrieval index (rebuildable from kb.json + sources)
tools/retrieval/index.duckdb
tools/retrieval/index.duckdb.wal
# ... plus any WAL quarantined by the corrupt-WAL recovery in db.py, and any
# pre-repair backup of the DB itself.
tools/retrieval/index.duckdb.wal.corrupt-*
tools/retrieval/index.duckdb.bak-*

# Ephemeral worktrees
/.qmd/
/.vc71_stage/

# Backup and generated DB files
*.bak
*.bak_lowmatch

# Ad-hoc screenshot captures
xemu-*.png
xbox_ss*.raw

# Xbox RAM dump artifacts (generated by xemu debugging)
xbox_ram_*.bin
init.txt

# Halo Memory Viewer recordings (binary; large, re-recordable - never commit)
*.halorec

# Host-only equivalence snapshots (copyrighted game memory - never commit; keep manifest)
tools/equivalence/host_snapshots/*.json
!tools/equivalence/host_snapshots/manifest.json

# xemu serial/debug log (regenerated each run)
xemu.log

# Honest current VC71 scores (regenerated by populate; vc71_scores.json is the committed floor)
tools/verify/vc71_current.json

# Stray artifacts that kept polluting `git status` (arch review 2026-07-07)
/-
/kb_functions.txt

# host-local scratch (probes, memory dumps, capture artifacts)
tmp/

# destructive-command-guard local config
.dcg/
tools/verify/vc71_cache.db

.rtk/*
.serena
recovery/*
!recovery/evidence/
!recovery/evidence/*.json
!recovery/goal_ledger.json
!recovery/bindings.json
scratch/*

# Claude Code plugin skill lockfile (local tooling, not project source)
skills-lock.json
.grok/*

# Host-only CI fixtures (snapshot.json is converted from a live RAM capture and
# embeds raw game memory). Ignored as a whole directory so CI never descends it.
/ci/

